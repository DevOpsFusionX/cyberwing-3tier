# --- Docker Hub ---
DOCKERHUB_USER=apna-dockerhub-username
IMAGE_TAG=latest

# --- Database ---
DB_NAME=guestbook
DB_USER=cwuser
DB_PASSWORD=yahan-koi-mazboot-password-likhein
DB_ROOT_PASSWORD=yahan-root-ka-mazboot-password-likhein

# --- Grafana ---
GRAFANA_PASSWORD=yahan-grafana-admin-password-likhein
GRAFANA_ROOT_URL=http://apna-server-ip:3000
